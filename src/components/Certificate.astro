---
import { siteConfig } from "../config";
const hasCertificates = siteConfig.certificates && siteConfig.certificates.length > 0;
---

{
  hasCertificates && (
    <section id="certificates" class="reveal p-8 sm:p-12 md:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          
          {/* Bagian Kiri: Judul */}
          <div class="lg:col-span-4 lg:sticky lg:top-24">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 tracking-tight break-words">
              Certificates
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full mb-8"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          {/* Bagian Kanan: Grid Sertifikat */}
          <div class="lg:col-span-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
              {siteConfig.certificates.map((cert) => {
                // Mengecek apakah sertifikat ini punya link atau tidak
                const Component = cert.link ? "a" : "div";
                const linkProps = cert.link
                  ? {
                      href: cert.link,
                      target: "_blank", // Buka di tab baru
                      rel: "noopener noreferrer",
                    }
                  : {};

                return (
                  <Component
                    {...linkProps}
                    class={`group flex flex-col overflow-hidden rounded-xl sm:rounded-2xl border border-gray-200 bg-gray-50 transition-all duration-300 ${
                      cert.link
                        ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1 cursor-pointer"
                        : ""
                    }`}
                  >
                    <div class="aspect-[4/3] overflow-hidden border-b border-gray-200/60 bg-gray-100 relative">
                      <img
                        src={cert.image}
                        alt={cert.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        loading="lazy"
                      />
                      
                      {/* Ikon panah muncul kalau ada link */}
                      {cert.link && (
                        <div class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-[#bf3853] z-10 shadow-sm opacity-0 group-hover:opacity-100">
                          <svg
                            class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </div>
                      )}
                    </div>
                    <div class="p-4 sm:p-5 flex flex-col flex-grow">
                      <h3 class="text-lg font-bold text-gray-900 mb-2">
                        {cert.title}
                      </h3>
                      <p class="text-sm text-gray-600 leading-relaxed">
                        {cert.description}
                      </p>
                    </div>
                  </Component>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}