---
import { siteConfig } from "../config";

// Tambahan fallback pengaman biar .map() nggak error kalau data belum ke-load
const certificates = siteConfig.certificates || [];
const hasCertificates = certificates.length > 0;
---

{
  hasCertificates && (
    <section id="certificate" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <!-- Bagian Judul -->
        <div class="mb-12 lg:mb-16">
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
            Certificates
          </h2>
          <div
            class="w-[75px] h-[5px] mt-2 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
        </div>

        <!-- Bagian Grid Card Sertifikat -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {certificates.map((cert) => (
            <div class="group flex flex-col bg-gray-50 rounded-2xl border border-gray-200 overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1 hover:border-gray-300">
              
              <!-- Wadah Gambar Sertifikat -->
              <div class="aspect-[4/3] overflow-hidden bg-gray-200 border-b border-gray-200">
                {cert.image ? (
                  <img
                    src={cert.image}
                    alt={cert.title}
                    class="w-full h-full object-cover transform transition-transform duration-500 group-hover:scale-[1.05]"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-400">
                    No Image
                  </div>
                )}
              </div>

              <!-- Wadah Teks (Judul & Deskripsi) -->
              <div class="p-6 sm:p-8 flex flex-col flex-grow">
                <h3 
                  class="text-xl font-bold text-gray-900 mb-3 transition-colors duration-300 group-hover:text-[var(--accent-color)]"
                  style={`--accent-color: ${siteConfig.accentColor}`}
                >
                  {cert.title}
                </h3>
                <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
                  {cert.description}
                </p>
              </div>
              
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}